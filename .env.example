# .env.example — 실제 키를 여기에 쓰지 마십시오.
# 이 파일은 키 "이름"만 알려주는 견본이며 커밋됩니다.
#   1) cp .env.example .env.local
#   2) 값을 채운다
#   3) .env.local 은 .gitignore 에 있어 커밋되지 않는다
#
# 실수로 키가 커밋되면 파일을 고쳐도 소용없습니다 — git 이력에 남습니다.
# 과정 담당자에게 알리고 virtual key 를 재발급받는 것이 유일한 조치입니다. (PRD §9.5)

# --- 필수 ---
# 과정에서 발급받은 교육용 virtual key. x-api-key 헤더로 나갑니다.
ANTHROPIC_API_KEY=

# --- 선택 ---
# 기본: claude-haiku-4 (실측 10.5초)  /  품질을 올리려면: claude-sonnet-4 (19~24초)
CLAUDE_MODEL=

# 엔드포인트가 바뀔 때만. 기본: https://copa.codyssey.kr/v1/messages
COPA_API_URL=


# IP별 분당 허용 호출 수 (기본 5)
RATE_LIMIT_PER_MIN=
